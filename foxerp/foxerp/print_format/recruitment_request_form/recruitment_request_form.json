 "font": "Default",
 "html": "<!DOCTYPE html>\n<html>\n<head>\n<style type=\"text/css\">\n    table {\n        font-size:8pt !important;\n        font-family: Arial !important;\n    }\n</style>\n</head>\n<div class=\"row section-break\" style=\"padding:5px;\" >\n  <div class=\"col-xs-3\" style=\"text-align:left;\"><img src=\"/files/leader_logo.png\"></div>\n    <div class=\"col-xs-6\" style=\"text-align:center;\">\n        <h4>RECRUITMENT REQUEST FORM</h4>\n    </div>  \n</div>\n    <div style=\"margin-bottom:-21px;\" data-fieldname=\"items\" data-fieldtype=\"Table\">\n        <table class=\"table table-bordered table-condensed\">\n            <thead>\n                <tr>\n                    <th rowspan=\"3\" style=\"text-align:center;\" class=\"table-sr\">Applicant Info</th>\n                    <th style=\"width:21%;\" class=\"\">Applicant Name</th>\n                    <td data-fieldtype=\"Table\" colspan=\"3\"><div class=\"value\">{{doc.applicant_name}}</div></td>\n                </tr>\n                <tr>\n                    <th style=\"width:21%;\" class=\"\">Nationality</th>\n                    <td style=\"width:21%;\" data-fieldtype=\"Table\"><div class=\"value\">{{doc.country}}</div></td>\n                    <th style=\"width:21%;\" class=\"value\">ID Number</th>\n                    <td style=\"width:21%;\" data-fieldtype=\"Table\"><div class=\"value\">{{doc.job_reference_id}}</div></td>\n                </tr>\n                <tr>\n                    {% if doc.new_employee %}\n                        <td style=\"width:21%;\" class=\"\"><input type=\"checkbox\" checked> New Employee</td>\n                    {% else %}\n                        <td style=\"width:21%;\" class=\"\"><input type=\"checkbox\"> New Employee</td>\n                    {% endif %}\n                    {% if doc.replacement %} \n                        <td style=\"width:21%;\" data-fieldtype=\"Table\"><div class=\"value\"><input type=\"checkbox\" checked> Replacement</div></td>\n                    {% else %}\n                        <td style=\"width:21%;\" data-fieldtype=\"Table\"><div class=\"value\"><input type=\"checkbox\"> Replacement</div></td>\n                    {% endif %}\n                    <td style=\"width:21%;\" class=\"value\">Replaced Emp Name & Salary</td>\n                    <td style=\"width:21%;\" data-fieldtype=\"Table\"><div class=\"value\">{{doc.replaced_emp_name_salary}}</div></td>\n                </tr>\n            </thead>\n    </table>\n</div>\n    <div style=\"margin-top:-21px;\" data-fieldname=\"items\" data-fieldtype=\"Table\">\n        <table class=\"table table-bordered table-condensed\">\n            <thead>\n                <tr>\n                    <th rowspan=\"4\" style=\"text-align:center;\">Job Info</th>\n                    <th style=\"width:21%;\" class=\"\">Job Title</th>\n                    <td style=\"width:21%;\" data-fieldtype=\"Table\"><div class=\"value\">{{doc.job_title}}</div></td>\n                    <th style=\"width:21%;\" class=\"\">Department</th>\n                    <td style=\"width:21%;\" data-fieldtype=\"Table\"><div class=\"value\">{{doc.department}}</div></td>\n                </tr>\n                <tr>\n                    <th style=\"width:21%;\" class=\"\">Bu/Product Name</th>\n                    <td style=\"width:21%;\" data-fieldtype=\"Table\"><div class=\"value\">{{doc.product_name}}</div></td>\n                    <th style=\"width:21%;\" class=\"\">Line Manager</th>\n                    <td style=\"width:21%;\" data-fieldtype=\"Table\"><div class=\"value\">{{frappe.db.get_value(\"User\", doc.line_manager, \"full_name\")}}</div></td>\n                </tr>\n                <tr>\n                    <th style=\"width:21%;\" class=\"\">Location</th>\n                    <td style=\"width:21%;\" data-fieldtype=\"Table\"><div class=\"value\">{{doc.location}}</div></td>\n                    <th style=\"width:21%;\" class=\"\">Department Head</th>\n                    <td style=\"width:21%;\" data-fieldtype=\"Table\"><div class=\"value\">{{frappe.db.get_value(\"User\", doc.department_head, \"full_name\")}}</div></td>\n                </tr>\n                <tr>\n                    <th style=\"width:21%;\" class=\"\">Joining Date</th>\n                    {% if doc.new_employee %}\n                        <td style=\"width:21%;\" class=\"\"><input type=\"checkbox\" checked> Immediately</td>\n                    {% else %}\n                        <td style=\"width:21%;\" class=\"\"><input type=\"checkbox\"> Immediately</td>\n                    {% endif %}\n                    <td style=\"width:21%;\" class=\"value\">Will Join On:</td>\n                    <td style=\"width:21%;\" data-fieldtype=\"Table\"><div class=\"value\">{{doc.expected_joining_date}}</div></td>\n                </tr>\n            \n            </thead>\n    </table>\n</div>\n    <div style=\"margin-bottom:-21px;\" data-fieldname=\"items\" data-fieldtype=\"Table\">\n        <table class=\"table table-bordered table-condensed\">\n            <thead>\n                <tr>\n                    <th rowspan=\"2\" style=\"text-align:center;width:16%;\" class=\"table-sr\">Hiring Type</th>\n                    {% if doc.hiring_type == \"Direct\" %}\n                        <td colspan=\"1\" data-fieldtype=\"Table\"><div class=\"value\"><input type=\"checkbox\" checked> Direct</div></td>\n                    {% else %}\n                        <td colspan=\"1\" data-fieldtype=\"Table\"><div class=\"value\"><input type=\"checkbox\"> Direct</div></td>\n                    {% endif %}\n                    {% if doc.hiring_type == \"Contract\" %}\n                        <td colspan=\"1\" data-fieldtype=\"Table\"><div class=\"value\"><input type=\"checkbox\" checked> Contract</div></td>\n                    {% else %}\n                        <td colspan=\"1\" data-fieldtype=\"Table\"><div class=\"value\"><input type=\"checkbox\"> Contract</div></td>\n                    {% endif %}\n                    {% if doc.hiring_type == \"Via Consultancy\" %}\n                        <td colspan=\"3\" data-fieldtype=\"Table\"><div class=\"value\"><input type=\"checkbox\" checked> Via Consultancy</div></td>\n                    {% else %}\n                        <td colspan=\"3\" data-fieldtype=\"Table\"><div class=\"value\"><input type=\"checkbox\"> Via Consultancy</div></td>\n                    {% endif %}\n                </tr>\n                <tr>\n                    <th style=\"width:16%;\" class=\"\">If Consultancy</th>\n                    <td style=\"width:20%;\" data-fieldtype=\"Table\"><div class=\"value\">Name of Consultancy: </div></td>\n                    <td style=\"width:20%;\" data-fieldtype=\"Table\"><div class=\"value\">{{doc.name_of_consultancy}}</div></td>\n                    <td style=\"width:14%;\" data-fieldtype=\"Table\"><div class=\"value\">One Time Cost: </div></td>\n                    <td style=\"width:14%;\" data-fieldtype=\"Table\"><div class=\"value\">{{doc.one_time_cost}}</div></td>\n                </tr>\n            </thead>\n    </table>\n</div>\n    <div style=\"margin-top:-21px;\" data-fieldname=\"items\" data-fieldtype=\"Table\">\n        <table class=\"table table-bordered table-condensed\">\n            <thead>\n                <tr>\n                    <th rowspan=\"3\" style=\"text-align:center;\">Salary Details</th>\n                    <th colspan=\"2\" class=\"\">Yearly Salary</th>\n                    <td colspan=\"2\" data-fieldtype=\"Table\"><div class=\"value\">{{\"%.2f\"|format(doc.yearly_salary)}} {{doc.currency}}</div></td>\n                    <td colspan=\"2\" data-fieldtype=\"Table\"><div class=\"value\">{{\"%.2f\"|format(doc.base_yearly_salary)}} {{frappe.db.get_value(\"Company\", doc.company, \"default_currency\")}}</div></td>\n                </tr>\n                 <tr>\n                    <th colspan=\"2\" class=\"\">Monthly Salary</th>\n                    <td colspan=\"2\" data-fieldtype=\"Table\"><div class=\"value\">{{\"%.2f\"|format(doc.monthly_salary)}} {{doc.currency}}</div></td>\n                    <td colspan=\"2\" data-fieldtype=\"Table\"><div class=\"value\">{{\"%.2f\"|format(doc.base_monthly_salary)}} {{frappe.db.get_value(\"Company\", doc.company, \"default_currency\")}}</div></td>\n                </tr>\n                <tr>\n                    <th style=\"width:14%\" class=\"\">Contract Type</th>\n                    {% if doc.contract_type == \"Permanent\" %}\n                        <td style=\"width:14%\" class=\"\"><input type=\"checkbox\" checked> Permanent</td>\n                    {% else %}\n                        <td style=\"width:14%\" class=\"\"><input type=\"checkbox\"> Permanent</td>\n                    {% endif %}\n                    {% if doc.contract_type == \"Full Time\" %}\n                        <td style=\"width:14%\" class=\"\"><input type=\"checkbox\" checked> Full Time</td>\n                    {% else %}\n                        <td style=\"width:14%\" class=\"\"><input type=\"checkbox\"> Full Time</td>\n                    {% endif %}\n                    {% if doc.contract_type == \"Contract\" %}\n                        <td style=\"width:14%\" class=\"\"><input type=\"checkbox\" checked> Contract</td>\n                    {% else %}\n                        <td style=\"width:14%\" class=\"\"><input type=\"checkbox\"> Contract</td>\n                    {% endif %}\n                    {% if doc.contract_type == \"Part Time\" %}\n                        <td style=\"width:14%\" class=\"\"><input type=\"checkbox\" checked> Part Time</td>\n                    {% else %}\n                        <td style=\"width:14%\" class=\"\"><input type=\"checkbox\"> Part Time</td>\n                    {% endif %}\n                    <td style=\"width:14%\" class=\"\"><input type=\"checkbox\">  ..........</td>\n                </tr>\n            \n            </thead>\n    </table>\n</div>\n    <div data-fieldname=\"items\" data-fieldtype=\"Table\">\n        <table class=\"table table-bordered table-condensed\">\n            <thead>\n                <tr>\n                    <th rowspan=\"2\" style=\"text-align:center;\" class=\"table-sr\">Requirements</th>\n                    {% if doc.mobile %}\n                        <td style=\"width:28%;\" data-fieldtype=\"Table\"><div class=\"value\"><input type=\"checkbox\" checked> Mobile</div></td>\n                    {% else %}\n                        <td style=\"width:28%;\" data-fieldtype=\"Table\"><div class=\"value\"><input type=\"checkbox\"> Mobile</div></td>\n                    {% endif %}\n                    {% if doc.medical_insurance %}\n                        <td style=\"width:28%;\" data-fieldtype=\"Table\"><div class=\"value\"><input type=\"checkbox\" checked> Medical Insurance</div></td>\n                    {% else %}\n                        <td style=\"width:28%;\" data-fieldtype=\"Table\"><div class=\"value\"><input type=\"checkbox\"> Medical Insurance</div></td>\n                    {% endif %}\n                    {% if doc.email %}\n                        <td style=\"width:28%;\" data-fieldtype=\"Table\"><div class=\"value\"><input type=\"checkbox\" checked> Email</div></td>\n                    {% else %}\n                        <td style=\"width:28%;\" data-fieldtype=\"Table\"><div class=\"value\"><input type=\"checkbox\"> Email</div></td>\n                    {% endif %}\n                </tr>\n                <tr>\n                    {% if doc.office %}\n                        <td data-fieldtype=\"Table\"><div class=\"value\"><input type=\"checkbox\" checked> Office</div></td>\n                    {% else %}\n                        <td data-fieldtype=\"Table\"><div class=\"value\"><input type=\"checkbox\"> Office</div></td>\n                    {% endif %}\n                    {% if doc.pc_accessories %}\n                        <td data-fieldtype=\"Table\"><div class=\"value\"><input type=\"checkbox\" checked> PC</div></td>\n                    {% else %}\n                        <td data-fieldtype=\"Table\"><div class=\"value\"><input type=\"checkbox\"> PC</div></td>\n                    {% endif %}\n                    {% if doc.laptop_accessories %}\n                        <td data-fieldtype=\"Table\"><div class=\"value\"><input type=\"checkbox\" checked> Laptop</div></td>\n                    {% else %}\n                        <td data-fieldtype=\"Table\"><div class=\"value\"><input type=\"checkbox\"> Laptop</div></td>\n                    {% endif %}\n                </tr>\n            </thead>\n    </table>\n</div>\n                <div data-fieldname=\"items\" data-fieldtype=\"Table\">\n                    <table class=\"table table-bordered table-condensed\">\n                        <thead>\n                            <tr>\n                                <th rowspan=\"2\" style=\"text-align:center;\" class=\"table-sr\">Benefits</th>\n                                <th style=\"width:28%;\" class=\"\">Leaves</th>\n                                <td style=\"width:56%;\" data-fieldtype=\"Table\"><div class=\"value\">As per Leader IT Policy</div></td>\n                            </tr>\n                             <tr>\n                                <th style=\"width:28%;\" class=\"\">Medical</th>\n                                <td style=\"width:56%;\" data-fieldtype=\"Table\"><div class=\"value\">As per Leader IT Policy</div></td>\n                            </tr>\n                        </thead>\n            </table>\n    </div>\n<h5 style=\"width:100%;text-align:left;background-color:lightgrey;padding:5px;\"><b>Approvals</b></h5>\n<div class=\"row section-break\" data-label=\"\">\n        <div class=\"col-xs-12 column-break\">\n<table style=\"width:100%;text-align:left;\">\n    <tr>\n        <td style=\"padding:10px;width:12.5%;\"><b>Requester<br>Name:</b></td>\n        {% if doc.requester_name %}\n            <td style=\"padding:10px;width:12.5%;\">{{doc.requester_name}}</td>\n        {% else %}\n            <td style=\"padding:10px;width:12.5%;\"></td>\n        {% endif %}\n        <td style=\"padding:10px;width:12.5%;\"><b>Product Manager<br>Name:</b></td>\n        {% if doc.product_manager_name %}\n            <td style=\"padding:10px;width:12.5%;\">{{doc.product_manager_name}}</td>\n        {% else %}\n            <td style=\"padding:10px;width:12.5%;\"></td>\n        {% endif %}\n        <td style=\"padding:10px;width:12.5%;\"><b>HR Head India<br>Name:</b></td>\n        {% if doc.hr_head_india_name %}\n            <td style=\"padding:10px;width:12.5%;\">{{doc.hr_head_india_name}}</td>\n        {% else %}\n            <td style=\"padding:10px;width:12.5%;\"></td>\n        {% endif %}\n        <td style=\"padding:10px;width:12.5%;\"><b>Director - Leader IT<br>Name:</b></td>\n        {% if doc.director_leader_it_name %}\n            <td style=\"padding:10px;width:12.5%;\">{{doc.director_leader_it_name}}</td>\n        {% else %}\n            <td style=\"padding:10px;width:12.5%;\"></td>\n        {% endif %}\n    </tr>\n    <tr>\n        <td style=\"padding:10px;\"><b>Date:</b></td>\n        <td style=\"padding:10px;\"></td>\n        <td style=\"padding:10px;\"><b>Date:</b></td>\n        <td style=\"padding:10px;\"></td>\n        <td style=\"padding:10px;\"><b>Date:</b></td>\n        <td style=\"padding:10px;\"></td>\n        <td style=\"padding:10px;\"><b>Date:</b></td>\n        <td style=\"padding:10px;\"></td>\n    </tr>\n    <tr>\n        <td style=\"padding:10px;\"><b>Signature:</b></td>\n        <td style=\"padding:10px;\"></td>\n        <td style=\"padding:10px;\"><b>Signature:</b></td>\n        <td style=\"padding:10px;\"></td>\n        <td style=\"padding:10px;\"><b>Signature:</b></td>\n        <td style=\"padding:10px;\"></td>\n        <td style=\"padding:10px;\"><b>Signature:</b></td>\n        <td style=\"padding:10px;\"></td>\n    </tr>\n\n</table>\n<hr>\n<table style=\"width:100%;text-align:left;\">\n    <tr>\n        <td style=\"padding:10px;width:25%;\"><b>VP International<br>Business & HR<br>Name:</b></td>\n        {% if doc.vp_international_business_hr_name %}\n            <td style=\"padding:10px;width:25%;\">{{doc.vp_international_business_hr_name}}</td>\n        {% else %}\n            <td style=\"padding:10px;width:25%;\"></td>\n        {% endif %}\n        <td style=\"padding:10px;width:25%;\"><b>CEO<br>Name:</b></td>\n        <td style=\"padding:10px;width:25%;\">ABDULMAJEED ALSOLIM</td>\n    </tr >\n    <tr>\n        <td style=\"padding:10px;\"><b>Date:</b></td>\n        <td style=\"padding:10px;\"></td>\n        <td style=\"padding:10px;\"><b>Date:</b></td>\n        <td style=\"padding:10px;\"></td>\n    </tr>\n    <tr>\n        <td style=\"padding:10px;\"><b>Signature:</b></td>\n        <td style=\"padding:10px;\"></td>\n        <td style=\"padding:10px;\"><b>Signature:</b></td>\n        <td style=\"padding:10px;\"></td>\n    </tr>\n\n</table>\n<hr>\n</div>\n</div>",
