 "doctype": "Print Format",
 "font": "Default",
 "html": "<!DOCTYPE html>\n<html>\n<head>\n<style type=\"text/css\">\n .print-format {\n     font-size:7pt !important;\n    }\n    .print-format th.darkBgRow{\n        background-color: lightgrey !important;\n    }\n</style>\n</head>\n<div class=\"row section-break\" style=\"border-bottom: 1px solid #d1d8dd;\">\n  <div class=\"col-xs-6\" style=\"text-align:left;\"><img src=\"/files/leader_logo.png\"></div>\n\t<div class=\"col-xs-6\" style=\"text-align:right;\">\n\t\t<h2>\u0641\u0627\u062a\u0648\u0631\u0629 \u0636\u0631\u064a\u0628\u064a\u0629 <br>Tax Invoice</h2>\n\t</div>  \n</div>\n</br>\n<div class=\"row section-break\" data-label=\"\">\n\t<div class=\"col-xs-10 column-break\">\n    <div class=\"row important data-field\">\n        <div class=\"col-xs-4\">\n\t\t\t<label>Invoice Number: </label>\n\t    </div>\n\t    <div class=\"col-xs-4\" style= \"text-align: center;\"> {{doc.name}} </div>\n\t    <div class=\"col-xs-4\" dir=\"rtl\" lang=\"ar\">\n\t\t\t<label>\u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629</label>\n\t    </div>\n\t</div>\n\t<div class=\"row important data-field\">\n        <div class=\"col-xs-4\">\n\t\t\t<label>Invoice Date: </label>\n\t    </div>\n\t    <div class=\"col-xs-4\" style= \"text-align: center;\"> {{doc.get_formatted(\"posting_date\")}} </div>\n\t    <div class=\"col-xs-4\" dir=\"rtl\" lang=\"ar\">\n\t\t\t<label>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629</label>\n\t    </div>\n\t</div>\n\t{% if doc.hijri_date %}\n\t\t<div class=\"row important data-field\">\n        <div class=\"col-xs-4\">\n\t\t\t<label>Hijri Date: </label>\n\t    </div>\n\t    <div class=\"col-xs-4\" dir=\"rtl\" lang=\"ar\" style= \"text-align: center;\"> {{ doc.hijri_date }} </div>\n\t    <div class=\"col-xs-4\" dir=\"rtl\" lang=\"ar\">\n\t\t\t<label>\u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0647\u062c\u0631\u064a</label>\n\t    </div>\n\t</div>\n\t{% endif %}\n\t{% if doc.delivery_date %}\n\t<div class=\"row important data-field\">\n        <div class=\"col-xs-4\">\n\t\t\t<label>Date of Supply:</label>\n\t    </div>\n\t    <div class=\"col-xs-4\" style= \"text-align: center;\"> {{doc.get_formatted(\"delivery_date\")}} </div>\n\t    <div class=\"col-xs-4\" dir=\"rtl\" lang=\"ar\">\n\t\t\t<label>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0648\u0631\u064a\u062f</label>\n\t    </div>\n\t</div>\n\t{% endif %}\n\t\t<div class=\"row important data-field\">\n        <div class=\"col-xs-4\">\n\t\t\t<label>Due Date</label>\n\t    </div>\n\t    <div class=\"col-xs-4\" style= \"text-align: center;\"> {{doc.get_formatted(\"due_date\")}} </div>\n\t    <div class=\"col-xs-4\" dir=\"rtl\" lang=\"ar\">\n\t\t\t<label>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u0633\u062a\u062d\u0642\u0627\u0642</label>\n\t    </div>\n\t</div>\n\t{% if doc.po_no %}\n\t<div class=\"row important data-field\">\n        <div class=\"col-xs-4\">\n\t\t\t<label>Reference No:</label>\n\t    </div>\n\t    <div class=\"col-xs-4\" style= \"text-align: center;\"> {{doc.po_no}} </div>\n\t    <div class=\"col-xs-4\" dir=\"rtl\" lang=\"ar\">\n\t\t\t<label>\u0631\u0642\u0645 \u0627\u0644\u0645\u0631\u062c\u0639</label>\n\t    </div>\n\t</div>\n\t{% endif %}\n\t{% if doc.payment_schedule[0].payment_term %}\n\t<div class=\"row important data-field\">\n        <div class=\"col-xs-4\">\n\t\t\t<label>Payment Terms:</label>\n\t    </div>\n\t    <div class=\"col-xs-4\" style= \"text-align: center;\"> {%- for data in doc.payment_schedule -%}\n        {{data.payment_term}}\n        {%- endfor -%} </div>\n\t    <div class=\"col-xs-4\" dir=\"rtl\" lang=\"ar\">\n\t\t\t<label>\u0634\u0631\u0648\u0637 \u0627\u0644\u062f\u0641\u0639</label>\n\t    </div>\n\t</div>\n\t{% endif %}\n\t{%if doc.items[0].reference_dn %}\n\t<div class=\"row important data-field\">\n        <div class=\"col-xs-4\">\n            {%if doc.items[0].reference_dt == \"Sales Order\" %}\n\t\t\t    <label>Sales Order:</label>\n\t\t\t{%- else -%}\n\t\t\t   <label>Delivery Note:</label>\n\t\t\t{%- endif -%}\n\t    </div>\n\t    <div class=\"col-xs-4\" style= \"text-align: center;\">\n        {{doc.items[0].reference_dn}} </div>\n\t    <div class=\"col-xs-4\" dir=\"rtl\" lang=\"ar\">\n\t        {%if doc.items[0].reference_dt == \"Sales Order\" %}\n\t\t\t    <label>\u0637\u0644\u0628 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a</label>\n\t\t\t{%- else -%}\n\t\t\t   <label>\u0645\u0630\u0643\u0631\u0629 \u062a\u0633\u0644\u064a\u0645:</label>\n\t\t\t{%- endif -%}\n\t    </div>\n\t</div>\n\t{%- endif -%}\n\t{% if doc.narration %}\n\t<div class=\"row important data-field\">\n        <div class=\"col-xs-4\">\n\t\t\t<label>Narration:</label>\n\t    </div>\n\t    <div class=\"col-xs-4\" style= \"text-align: center;\">\n        {{doc.narration}} </div>\n\t    <div class=\"col-xs-4\" dir=\"rtl\" lang=\"ar\">\n\t\t\t<label>\u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a</label>\n\t    </div>\n\t</div>\n\t{% endif %}\n\t</div>\n\t<div class=\"col-xs-2 column-break\">\n\t\t<img src=\"{{ doc.qr_code }}\" class=\"img-responsive\">\n\t</div>\n</div>\n            {%- if doc.company_address -%}\n                {%- set seller_address_doc = frappe.get_doc(\"Address\", {\"name\": doc.company_address }) -%}\n            {%- endif -%}\n            <!-- Seller Buyer Information Table-->\n            <table class= \"table table-bordered table-condensed\"> \n                <tr>\n                    <th align=\"left\" width=\"25%\">Seller</th>\n                    <th dir=\"rtl\" lang=\"ar\" class=\"text-right\" width=\"25%\">\u0627\u0644\u0645\u0648\u0631\u062f</th>\n                    <th align=\"left\" width=\"25%\">Buyer</th>\n                    <th dir=\"rtl\" lang=\"ar\" class=\"text-right\" width=\"25%\">\u0627\u0644\u0639\u0645\u064a\u0644</th>\n                </tr>\n                <tr>\n                    <td align=\"left\"><b> Name: </b>{{doc.company}} </td>\n                    <td  dir=\"rtl\" lang=\"ar\"><b>\u0627\u0644\u0627\u0633\u0645:</b>  {{frappe.db.get_value('Company', doc.company, \"company_name_in_arabic\")}}</td>\n                    <td align=\"left\"><b> Name: </b>{{doc.customer}} </td>\n                    <td  dir=\"rtl\" lang=\"ar\"><b>\u0627\u0644\u0627\u0633\u0645:</b> {{doc.customer_name_in_arabic}} </td>\n                </tr>\n                <tr>    \n                    <td align=\"left\"><b> VAT Number: </b>{{frappe.db.get_value('Company', doc.company, \"tax_id\")}} </td>\n                    <td  dir=\"rtl\" lang=\"ar\"><b>\u0631\u0642\u0645 \u062a\u0633\u062c\u064a\u0644 \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629:</b> {{frappe.db.get_value('Company', doc.company, \"tax_id\")}} </td>\n                    <td align=\"left\"><b> VAT Number: </b>{{frappe.db.get_value('Customer', doc.customer, \"tax_id\") or ''}} </td>\n                    <td  dir=\"rtl\" lang=\"ar\"><b>\u0631\u0642\u0645 \u062a\u0633\u062c\u064a\u0644 \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629:</b> {{frappe.db.get_value('Customer', doc.customer, \"tax_id\") or ''}}</td>\n                </tr>  \n\n                <tr>\n                    <td align=\"left\">\n                        <b> Address </b> \n                        <br>\n                        {%- if doc.company_address -%}\n                        {{seller_address_doc.address_line1}}\n                        <br>\n                        {{seller_address_doc.city}}\n                        <br>\n                        {{seller_address_doc.country}}\n                        {%if seller_address_doc.pincode%}\n                        <br>\n                        {{seller_address_doc.pincode}}\n                        {%endif%}\n                        {%if seller_address_doc.phone%}\n                        <br>\n                        {{seller_address_doc.phone}}\n                        {%endif%}\n                         {%- endif -%}\n                    </td>\n                    <td  dir=\"rtl\" lang=\"ar\">\n                        <b>\u0639\u0646\u0648\u0627\u0646</b>\n                         <br>\n                        {%- if doc.company_address -%}\n                        {{seller_address_doc.address_line1}}\n                        <br>\n                        {{seller_address_doc.city}}\n                        <br>\n                        {{seller_address_doc.country}}\n                        {%if seller_address_doc.pincode%}\n                        <br>\n                        {{seller_address_doc.pincode}}\n                        {%endif%}\n                        {%if seller_address_doc.phone%}\n                        <br>\n                        {{seller_address_doc.phone}}\n                        {%endif%}\n                         {%- endif -%}\n                    </td>\n                    <td align=\"left\">\n                        <b> Address </b> \n                        <br>\n                        {{doc.address_display or \"\"}}\n                    </td>\n                    <td  dir=\"rtl\" lang=\"ar\">\n                        <b>\u0639\u0646\u0648\u0627\u0646</b>\n                         <br>\n                        {{doc.address_display or \"\"}}\n                    </td>\n                </tr>  \n\n            </table>\n            <!--Line Items Table  -->\n            <table class=\"table table-bordered table-condensed\">\n                <tr>\n                    {%- if doc.company == \"Leader Investment Group\" -%}\n                        <th colspan=\"10\">Line Item<span class=\"pull-right\">\u062a\u0648\u0635\u064a\u0641 \u0627\u0644\u0633\u0644\u0639\u0629 \u0623\u0648 \u0627\u0644\u062e\u062f\u0645\u0629</span> </th>\n                    {%- else -%}\n                        <th colspan=\"11\">Line Item<span class=\"pull-right\">\u062a\u0648\u0635\u064a\u0641 \u0627\u0644\u0633\u0644\u0639\u0629 \u0623\u0648 \u0627\u0644\u062e\u062f\u0645\u0629</span> </th>\n                    {%- endif -%}\n                </tr>\n                <tr>\n                    <th class=\"darkBgRow\">{{_(\"Sr.\")}} <br>\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u062a\u0633\u0644\u0633\u0644\u064a</th>\n                    {%- if doc.company == \"Leader Investment Group\" -%}\n                        <th class=\"darkBgRow\" style= \"text-align: center;\">Description of Product/Service <br> \u0637\u0628\u064a\u0639\u0629 \u0627\u0644\u0633\u0644\u0639 \u0623\u0648 \u0627\u0644\u062e\u062f\u0645\u0627\u062a</th>\n                    {%- else -%}\n                        <th class=\"darkBgRow\" style= \"text-align: center;\">{{_(\"Item Code\")}} <br>\u0631\u0645\u0632 \u0627\u0644\u0635\u0646\u0641</th>\n                        <th class=\"darkBgRow\" style= \"text-align: center;\">{{_(\"Item Name\")}} <br>\u0627\u0633\u0645 \u0627\u0644\u0639\u0646\u0635\u0631</th>\n                    {%- endif -%}\n                    <th class=\"darkBgRow\">Unit Price <br> \u0633\u0639\u0631 \u0627\u0644\u0648\u062d\u062f\u0629</th>\n                    <th class=\"darkBgRow\">Quantity<br> \u0643\u0645\u064a\u0629</th>\n                    <th class=\"darkBgRow\">UOM<br>\u0648\u062d\u062f\u0629 \u0627\u0644\u0642\u064a\u0627\u0633</th>\n                    <th class=\"darkBgRow\">Sub Total<br>\u0627\u0644\u0645\u062c\u0645\u0648\u0639 \u0627\u0644\u0641\u0631\u0639\u064a</th>\n                    <th class=\"darkBgRow\">Discount<br>\u062e\u0635\u0645</th>\n                    <th class=\"darkBgRow\">Taxable Amount<br>\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u062e\u0627\u0636\u0639 \u0644\u0644\u0636\u0631\u064a\u0628\u0629</th>\n                    <th class=\"darkBgRow\">VAT Amount<br>\u0642\u064a\u0645\u0629 \u0627\u0644\u0636\u0631\u064a\u0628\u0629</th>\n                    <th class=\"darkBgRow\">Total Amount<br>\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</th>\n                </tr>\n                {%- for row in doc.items -%}\n                <tr>\n                    <td style= \"text-align: center;\">{{row.idx}} </td>\n                    {%- if doc.company == \"Leader Investment Group\" -%}\n                        <td style= \"text-align: center;\">{{row.description}} </td>\n                        <td style= \"text-align: center;\">{{row.rate}} </td>\n                    {%- else -%}\n                        <td style= \"text-align: center;\">{{row.item_code}} </td>\n                        <td style= \"text-align: center;\">{{row.item_name}} </td>\n                        <td style= \"text-align: center;\">{{row.price_list_rate}} </td>\n                    {%- endif -%}\n                    <td style= \"text-align: center;\">{{row.qty}}</td>\n                    <td>{{row.uom}}</td>\n                     {%- if doc.company == \"Leader Investment Group\" -%}\n                    <td style= \"text-align: right;\">{{'{:,.2f}'.format((row.rate * row.qty)|float)}}</td>\n                    {%- else -%}\n                    <td style= \"text-align: right;\">{{'{:,.2f}'.format((row.price_list_rate * row.qty)|float)}}</td>\n                    {%- endif -%}\n                    <td style= \"text-align: right;\">{{'{:,.2f}'.format((row.discount_amount * row.qty)|float)}}</td>\n                    <td style= \"text-align: right;\">{{'{:,.2f}'.format(row.net_amount)}}</td>\n                    <td style= \"text-align: right;\">{{'{:,.2f}'.format(row.tax_amount)}}</td>\n                    <td style= \"text-align: right;\">{{'{:,.2f}'.format(row.total_amount)}}</td>\n                </tr>\n                {%- endfor -%}\n            </table>\n    \n            <!-- Total Amounts Table -->\n            <table class=\"table table-bordered table-condensed\">  \n                <tr>\n                    <th colspan=\"3\"><b>Total Amounts</b><span class=\"pull-right\"><b>\u0627\u0644\u0645\u0628\u0627\u0644\u063a \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0629</b></span></th>\n                </tr>\n                <tr>\n                    <td style= \"text-align: center;\">Total (Excluding VAT)</td>\n                    <td style= \"text-align: center;\">{{doc.get_formatted(\"total\")}}</td>\n                    <td dir=\"rtl\" lang=\"ar\" style= \"text-align: center;\">\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a (\u0628\u0627\u0633\u062a\u062b\u0646\u0627\u0621 \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629)</td>\n                </tr>\n                <tr>\n                    <td style= \"text-align: center;\">Discount</td>\n                    <td style= \"text-align: center;\">{{doc.get_formatted(\"discount_amount\")}}</td>\n                    <td dir=\"rtl\" lang=\"ar\" style= \"text-align: center;\">\u062e\u0635\u0645</td>\n                </tr>\n                <tr>\n                    <td style= \"text-align: center;\">Taxable Amount</td>\n                    <td style= \"text-align: center;\">{{doc.get_formatted(\"net_total\")}}</td>\n                    <td dir=\"rtl\" lang=\"ar\" style= \"text-align: center;\">\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u062e\u0627\u0636\u0639 \u0644\u0644\u0636\u0631\u064a\u0628\u0629</td>\n                </tr>\n                {% if doc.taxes|length > 0 %}\n                {% if doc.taxes[0].description %}\n                 <tr>\n                    <td style= \"text-align: center;\">VAT %</td>\n                    <td style= \"text-align: center;\">{{doc.taxes[0].rate}} %</td>\n                    <td dir=\"rtl\" lang=\"ar\" style= \"text-align: center;\">\u066a \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629</td>\n                </tr>\n                {% endif %}\n                {% endif %}\n                <tr>\n                    <td style= \"text-align: center;\">Total VAT</td>\n                    <td style= \"text-align: center;\">{{doc.get_formatted(\"total_taxes_and_charges\")}}</td>\n                    <td dir=\"rtl\" lang=\"ar\" style= \"text-align: center;\">\u0625\u062c\u0645\u0627\u0644\u064a \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629</td>\n                </tr>\n                <tr>\n                    <td style= \"text-align: center;\">Total Amount Due</td>\n                    <td style= \"text-align: center;\">{{doc.get_formatted(\"grand_total\")}}</td>\n                    <td dir=\"rtl\" lang=\"ar\" style= \"text-align: center;\">\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u0633\u062a\u062d\u0642</td>\n                </tr>\n                <tr>\n                    <td style= \"text-align: center;\">Total Amount Due in Words</td>\n                    <td style= \"text-align: center;\">{{doc.in_words}}</td>\n                    <td dir=\"rtl\" lang=\"ar\" style= \"text-align: center;\">\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0633\u062a\u062d\u0642 \u0628\u0627\u0644\u0643\u0644\u0645\u0627\u062a</td>\n                </tr>\n                {% if doc.in_words_arabic %}\n                <tr>\n                    <td style= \"text-align: center;\">Total Amount Due in Words (Arabic)</td>\n                    <td style= \"text-align: center;\">{{doc.in_words_arabic}}</td>\n                    <td dir=\"rtl\" lang=\"ar\" style= \"text-align: center;\">\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u0633\u062a\u062d\u0642 \u0628\u0627\u0644\u0643\u0644\u0645\u0627\u062a (\u0639\u0631\u0628\u064a)</td>\n                </tr>\n                {% endif %}\n            </table>\n    </html>",
