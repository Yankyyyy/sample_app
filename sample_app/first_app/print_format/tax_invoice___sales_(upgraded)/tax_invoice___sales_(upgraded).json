 "html": "<!DOCTYPE html>\n<html>\n<head>\n<h1 style=\"text-align:center;font-family:verdana;font-size:130%;\"><b>\u0641\u0627\u062a\u0648\u0631\u0629 \u0636\u0631\u064a\u0628\u064a\u0629</b></h1>\n<p style=\"text-align:center;font-family:verdana;font-size:130%;\"><b>Tax Invoice</b></p>\n\n<br>\n<br>    \n\n\n\n    \n<style type=\"text/css\">\n   \n\n    tr.darkBgRow{\n        background-color: #696969;\n    }\n    \n    td.hascellBorder{\n        border: 2px groove;\n        border-color: darkslategrey;\n    }\n           \n</style>\n            <table style=\"width:100%;font-size:90%\" > \n                <tr>\n                    <td ></td>\n                    <td ></td>\n                    <td ></td>\n                    <td ></td>\n                    <td ></td>\n                    <td width=\"24%\" rowspan=\"9\" class=\"hascellBorder\">\n                           {% set files = frappe.get_all('File', filters={'attached_to_doctype': 'Sales Invoice', 'attached_to_name': doc.name}, fields=['file_name', 'file_url']) %}\n                        {%- for file in files -%}\n                        <img src=\"{{ file.file_url}}\" alt=\"{{ file.file_name }}\" />\n                        {%- endfor -%}  \n                    </td>                    \n                </tr>\n            \n                <tr>\n                    <td width=\"17%\" align=\"left\" class=\"hascellBorder\"><b>Invoice Number:</b></td>\n                    <td width=\"17%\" align=\"left\" class=\"hascellBorder\"> {{doc.name}}</td>\n                    <td width=\"17%\"  dir=\"rtl\" lang=\"ar\" class=\"hascellBorder\">{{doc.name}}</td>\n                    <td width=\"17%\"  dir=\"rtl\" lang=\"ar\" class=\"hascellBorder\"> <b> \u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629 </b></td>\n                    <td width=\"8%\"></td>\n                </tr>\n                <tr>\n                    <td ></td>\n                    <td ></td>\n                    <td ></td>\n                    <td ></td>\n                    <td ></td>\n                </tr>\n                <tr>\n                    <td ></td>\n                    <td ></td>\n                    <td ></td>\n                    <td ></td>\n                    <td ></td>\n                </tr>\n                <tr>\n                    <td ></td>\n                    <td ></td>\n                    <td ></td>\n                    <td ></td>\n                    <td ></td>\n                </tr>\n                <tr>\n                    <td  align=\"left\" class=\"hascellBorder\">   <b>Invoice Issue Date:</b> </td>\n                    <td  align=\"left\" class=\"hascellBorder\"> {{doc.get_formatted(\"posting_date\")}} </td>\n                    <td   dir=\"rtl\" lang=\"ar\" class=\"hascellBorder\"> {{doc.get_formatted(\"posting_date\")}} </td>\n                    <td   dir=\"rtl\" lang=\"ar\" class=\"hascellBorder\"> <b> \u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629 </b></td>\n                    <td ></td>\n                </tr>\n                <tr>\n                    <td  align=\"left\" class=\"hascellBorder\">   <b>Date of Supply:</b> </td>\n                    <td align=\"left\" class=\"hascellBorder\"> {{doc.get_formatted(\"posting_date\")}} </td>\n                    <td   dir=\"rtl\" lang=\"ar\" class=\"hascellBorder\"> {{doc.get_formatted(\"posting_date\")}} </td>\n                    <td  dir=\"rtl\" lang=\"ar\" class=\"hascellBorder\"> <b>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0648\u0631\u064a\u062f</b>  </td>\n                    <td ></td>\n                </tr>\n                <tr>\n                    <td ></td>\n                    <td ></td>\n                    <td></td>\n                    <td ></td>\n                    <td ></td>\n                </tr>\n                <tr>\n                    <td ></td>\n                    <td ></td>\n                    <td ></td>\n                    <td ></td>\n                    <td ></td>\n                </tr>\n                        \n            </table>\n            <br>\n            <br>\n    \n            {%- set seller_address_doc = frappe.get_doc(\"Address\", {\"name\": doc.company_address }) -%}\n            {%- set buyer_address_doc = frappe.get_doc(\"Address\", {\"name\": doc.customer_address }) -%}\n    \n            <!-- Seller Buyer Information Table-->\n\n            <table style=\"width:100%;font-size:90%\" border=2 > \n                <tr>\n                    <th align=\"left\" >Seller</th>\n                    <th>  </th>\n                    <th dir=\"rtl\" lang=\"ar\">  </th>\n                    <th dir=\"rtl\" lang=\"ar\" class=\"text-right\">   \u062a\u0627\u062c\u0631 </th>\n                    <th align=\"left\">Buyer</th>\n                    <th> </th>\n                    <th dir=\"rtl\" lang=\"ar\">  </th>\n                    <th dir=\"rtl\" lang=\"ar\"  class=\"text-right\"> \u0645\u0634\u062a\u0631 </th>\n                </tr>\n                <tr>\n                    <td align=\"left\" width=\"12.5%\"><b> Name </b></td>\n                    <td  width=\"12.5%\"> {{doc.company}} </td>\n                    <td  dir=\"rtl\" lang=\"ar\"  width=\"12.5%\"> {{doc.company}} </td>\n                    <td  dir=\"rtl\" lang=\"ar\"  width=\"12.5%\">\u0627\u0633\u0645</td>\n                    <td align=\"left\" width=\"12.5%\"><b> Name </b></td>\n                    <td width=\"12.5%\" > {{doc.customer}}  </td>\n                    <td  dir=\"rtl\" lang=\"ar\"  width=\"12.5%\" > {{doc.customer}}  </td>\n                    <td  dir=\"rtl\" lang=\"ar\"  width=\"12.5%\">\u0627\u0633\u0645</td>\n                </tr>  \n\n                <tr>\n                    <td align=\"left\" colspan=\"2\">\n                        <b> Address </b> \n                        <br>\n                        {{seller_address_doc.address_line1}}\n                        {{seller_address_doc.city}}\n                        Postal Code:{{seller_address_doc.address_line1}}\n                        {{seller_address_doc.country}}\n                        Phone:{{seller_address_doc.phone}}\n                    </td>\n                    <td  dir=\"rtl\" lang=\"ar\" colspan=\"2\" >\n                        <b>\u0639\u0646\u0648\u0627\u0646</b>\n                         <br>\n                        {{doc.address_display or \"\"}}\n                    </td>\n                    <td align=\"left\" colspan=\"2\">\n                        <b> Address </b> \n                        <br>\n                        {{doc.address_display or \"\"}}\n                    </td>\n                    <td  dir=\"rtl\" lang=\"ar\" colspan=\"2\" >\n                        <b>\u0639\u0646\u0648\u0627\u0646</b>\n                         <br>\n                        {{doc.address_display or \"\"}}\n                    </td>\n                </tr>  \n\n            </table>\n            <br>\n            <br>\n            <!--Line Items Table  -->\n            <table style=\"width:100%;font-size:90%\" border=2 > \n                <tr>\n                    <th colspan=\"4\"><b> Line Items :</b></th>\n                    <th colspan=\"4\" dir=\"rtl\" lang=\"ar\" class=\"text-right\" > \u0627\u0644\u0628\u0646\u0648\u062f</th>\n                </tr>\n    \n                <tr class=\"darkBgRow\">\n                    <td>Nature of goods or services <br> \u0637\u0628\u064a\u0639\u0629 \u0627\u0644\u0633\u0644\u0639 \u0623\u0648 \u0627\u0644\u062e\u062f\u0645\u0627\u062a</td>\n                    <td class=\"text-center\">Unit Price <br> \u0633\u0639\u0631 \u0627\u0644\u0648\u062d\u062f\u0629</td>\n                    <td class=\"text-center\"> Quantity<br> \u0643\u0645\u064a\u0629</td>\n                    <td class=\"text-center\"> Taxable Amount<br> \u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u062e\u0627\u0636\u0639 \u0644\u0644\u0636\u0631\u064a\u0628\u0629</td>\n                    <td class=\"text-center\"> Discount<br> \u062e\u0635\u0645</td>\n                    <td class=\"text-center\"> Tax Rate<br> \u0645\u0639\u062f\u0644 \u0627\u0644\u0636\u0631\u064a\u0628\u0629</td>\n                    <td class=\"text-center\"> Tax Amount<br> \u0642\u064a\u0645\u0629 \u0627\u0644\u0636\u0631\u064a\u0628\u0629</td>\n                    <td class=\"text-center\"> Item Subtotal(including VAT)<br> \u0627\u0644\u0645\u062c\u0645\u0648\u0639 \u0627\u0644\u0641\u0631\u0639\u064a \u0644\u0644\u0628\u0646\u062f (\u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629)</td>\n                </tr>\n    \n                {%- for row in doc.items -%}\n                <tr>\n                    <td width=\"12.5%\" align=\"left\"> {{row.item_code}} </td>\n                    <td width=\"12.5%\" align=\"right\">{{\"{:.2f}\".format(row.rate)}} {{doc.currency}}</td>\n                    <td width=\"12.5%\" align=\"right\">{{row.qty}}</td>\n                    <td width=\"12.5%\" align=\"right\"></td>\n                    <td width=\"12.5%\" align=\"right\"> {{\"{:.2f}\".format(row.discount_amount)}}  {{doc.currency}}</td>\n                    <td width=\"12.5%\" align=\"right\"></td>\n                    <td width=\"12.5%\" align=\"right\"></td>\n                    <td width=\"12.5%\" align=\"right\">{{\"{:.2f}\".format(row.amount)}}  {{doc.currency}}</td>\n                </tr>\n                {%- endfor -%}\n         \n            </table>\n    \n            <br>\n    \n            <!-- Total Amounts Table -->\n            <table style=\"width:100%;font-size:90%\" border=2 >  \n                <tr>\n                    <th colspan=\"2\"><b>Total Amounts</b></th>\n                    <th colspan=\"2\" class=\"text-right\"><b>\u0627\u0644\u0645\u0628\u0627\u0644\u063a \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0629</b></th>\n                </tr>\n                <tr>\n                    <td width=\"37.5%\"></td>\n                    <td width=\"25%\"><b> Total (Excluding VAT)</b></td>\n                    <td width=\"25%\" dir=\"rtl\" lang=\"ar\">\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a (\u0628\u0627\u0633\u062a\u062b\u0646\u0627\u0621 \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629)</td>\n                    <td width=\"12.5%\" align=\"right\"> {{\"{:.2f}\".format(doc.total)}} {{doc.currency}}</td>\n                </tr>\n                <tr>\n                    <td></td>\n                    <td align=\"left\"><b>Discount</b></td>\n                    <td dir=\"rtl\" lang=\"ar\">\u062e\u0635\u0645</td>\n                    <td align=\"right\">{{\"{:.2f}\".format(doc.discount_amount)}} {{doc.currency}} </td>\n                </tr>\n                <tr>\n                    <td></td>\n                    <td align=\"left\"><b>Total Taxable Amount(Excluding VAT)</b></td>\n                    <td dir=\"rtl\" lang=\"ar\">\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u062e\u0627\u0636\u0639 \u0644\u0644\u0636\u0631\u064a\u0628\u0629 (\u0628\u0627\u0633\u062a\u062b\u0646\u0627\u0621 \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629)</td>\n                    <td align=\"right\"></td>\n                </tr>\n                <tr>\n                    <td></td>\n                    <td align=\"left\"><b>Total VAT</b></td>\n                    <td dir=\"rtl\" lang=\"ar\">\u0625\u062c\u0645\u0627\u0644\u064a \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629</td>\n                    <td align=\"right\"></td>\n                </tr>\n                <tr>\n                    <td></td>\n                    <td align=\"left\"><b>Total Amount Due</b></td>\n                    <td dir=\"rtl\" lang=\"ar\">\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u0633\u062a\u062d\u0642</td>\n                    <td align=\"right\">{{\"{:.2f}\".format(doc.grand_total)}} {{doc.currency}}</td>\n                </tr>\n            </table>\n    \n    </html>",
