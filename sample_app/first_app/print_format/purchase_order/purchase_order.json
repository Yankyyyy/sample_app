 "doctype": "Print Format",
 "font": "Default",
 "html": "<style>\n    .print-title{\n        text-transform: uppercase;\n    }\n    .print-format th {\n\t    background-color: #c5c6c7 !important;\n    }\n    .table-bordered > thead > tr > th, .table-bordered > tbody > tr > th, .table-bordered > tfoot > tr > th, .table-bordered > thead > tr > td, .table-bordered > tbody > tr > td, .table-bordered > tfoot > tr > td\n    {\n        border: 1px solid black;\n    }\n    .table-bordered{\n        border: 1px solid black;\n    }\n    th{\n        text-align: center;\n    }\n</style>\n\n{% if letter_head and not no_letterhead -%}\n<div class=\"letter-head\">{{ letter_head }}</div>\n{%- endif %}\n\n<div class=\"print-title\" style=\"text-align:center;\">\n    <h2 style=\"margin: 0px;\">\n        <div><b>{{_(\"Purchase Order\")}}</b></div>\n    </h2>\n</div>\n\n<div class=\"row section-break\">\n    <div class=\"col-xs-6 column-break\">\n        <div class=\"row data-field\">\n            <div class=\"col-xs-5\">\n                <label>{{_(\"Purchase Order ID\")}}:</label>\n            </div>\n            <div class=\"col-xs-7 value\">\n                <b>{{doc.name}}</b>\n            </div>\n        </div>\n        <div class=\"row data-field\">\n            <div class=\"col-xs-5\">\n                <label>{{_(\"Requested Ship Date\")}}:</label>\n            </div>\n            <div class=\"col-xs-7 value\">\n                {{doc.get_formatted(\"creation\")}}\n            </div>\n        </div>\n        {%- if doc.order_confirmation_no -%}\n        <div class=\"row data-field\">\n            <div class=\"col-xs-5\">\n                <label>{{_(\"Reference No\")}}:</label>\n            </div>\n            <div class=\"col-xs-7 value\">\n                {{ doc.order_confirmation_no }}\n            </div>\n        </div>\n        {%- endif %}\n        {%- if doc.narration -%}\n        <div class=\"row data-field\">\n            <div class=\"col-xs-5\">\n                <label>{{_(\"Narration\")}}:</label>\n            </div>\n            <div class=\"col-xs-7 value\">\n               {{doc.narration}}\n            </div>\n        </div>\n        {%- endif %}\n    </div>\n    <div class=\"col-xs-6 column-break\">\n        <div class=\"row data-field\">\n            <div class=\"col-xs-5\">\n                <label>{{_(\"PO Date\")}}:</label>\n            </div>\n            <div class=\"col-xs-7 value\">\n                {{ doc.get_formatted(\"transaction_date\") }}\n            </div>\n        </div>\n        <div class=\"row data-field\">\n            <div class=\"col-xs-5\">\n                <label>{{_(\"Currency\")}}: </label>\n            </div>\n            <div class=\"col-xs-7 value\">\n                {{doc.currency}}\n            </div>\n        </div>\n    </div>\n</div>\n\n<div class=\"row section-break\">\n    <div class=\"col-xs-12 column-break\">\n        <div class=\"col-xs-6 column-break\">\n            <div class=\"row\" style=\"text-align: center;\"><b>{{_(\"Supplier Information\")}}</b></div>\n            <div class=\"row\" style=\"border-top: 1px solid; border-right: 1px solid; padding-bottom: 5px;\">\n                {{doc.address_display}} \n                {%-if doc.contact_display -%}</br> {{doc.contact_display}}\n                {%- endif -%}\n                {%-if doc.contact_display -%}</br> {{doc.contact_email}}\n                {%- endif -%}</div>\n        </div>\n        <div class=\"col-xs-6 column-break\">\n            <div class=\"row\" style=\"text-align: center;\"><b>{{_(\"Ship To Address\")}}</b></div>\n            <div class=\"row\" style=\"border-top: 1px solid; padding-left: 2px;\"> {{doc.shipping_address_display}} </div>\n        </div>\n    </div>\n</div>\n\n<div class=\"row section-break\">\n    <div class=\"col-xs-12 column-break\">\n        <table class=\"table table-bordered table-condensed\" style=\"margin: 0px !important;\">\n            <thead>\n                <tr style=\"text-align: center;\">\n                    <th style=\"width: 10%;\"> {{_(\"Item Code\")}} </th>\n                    <th style=\"width: 10%;\"> {{_(\"Item\")}} </th>\n                    <th style=\"width: 25%;\"> {{_(\"Description\")}} </th>\n                    <th style=\"width: 9%;\"> {{_(\"Price\")}} </th>\n                    <th style=\"width: 10%;\"> {{_(\"Quantity\")}} </th>\n                    <th style=\"width: 10%;\"> {{_(\"Sub Total\")}} </th>\n                    <th style=\"width: 8%;\"> {{_(\"VAT %\")}} </th>\n                    <th style=\"width: 8%;\"> {{_(\"VAT\")}} </th>\n                    <th style=\"width: 10%;\"> {{_(\"Total\")}} </th>\n                </tr>\n            </thead>\n            <tbody>\n                {%- for row in doc.items -%}\n                    <tr>\n                        <td style=\"text-align: center;\"> {{row.item_code}} </td>\n                        <td style=\"text-align: center;\"> {{row.item_name}} </td>\n                        <td style=\"text-align: center;\"> {{row.description}} </td>\n                        <td class=\"text-right\"> {{\"%.2f\"|format(row.rate)}} </td>\n                        <td class=\"text-center\"> {{\"%.2f\"|format(row.qty)}} {{row.uom}} </td>\n                        <td class=\"text-right\"> {{\"%.2f\"|format(row.amount)}} </td>\n                        <td class=\"text-right\"> {{\"%.2f\"|format(row.tax_rate)}} </td>\n                        <td class=\"text-right\"> {{\"%.2f\"|format(row.tax_amount)}} </td>\n                        <td class=\"text-right\"> {{\"%.2f\"|format(row.total_amount)}} </td>\n                    </tr>\n                    {% if row.page_break == 1 -%}\n                        </tbody>\n                        </table>\n                        </div>\n                        </div>\n                        <div class=\"page-break\"></div>\n                        \n                        <div class=\"row section-break\">\n                            <div class=\"col-xs-12 column-break\">\n                                <table class=\"table table-bordered table-condensed\" style=\"margin: 0px !important;\">\n                                    <thead>\n                                        <tr style=\"text-align: center;\">\n                                            <th style=\"width: 10%;\"> {{_(\"Item Code\")}} </th>\n                                            <th style=\"width: 10%;\"> {{_(\"Item\")}} </th>\n                                            <th style=\"width: 25%;\"> {{_(\"Description\")}} </th>\n                                            <th style=\"width: 9%;\"> {{_(\"Price\")}} </th>\n                                            <th style=\"width: 10%;\"> {{_(\"Quantity\")}} </th>\n                                            <th style=\"width: 10%;\"> {{_(\"Sub Total\")}} </th>\n                                            <th style=\"width: 8%;\"> {{_(\"VAT %\")}} </th>\n                                            <th style=\"width: 8%;\"> {{_(\"VAT\")}} </th>\n                                            <th style=\"width: 10%;\"> {{_(\"Total\")}} </th>\n                                        </tr>\n                                    </thead>\n                                    <tbody>\n                    {%- endif %}\n                {%- endfor -%}\n            </tbody>\n        </table>\n    </div>\n</div>\n\n\n<div class=\"row section-break\" style=\"border-bottom: 1px solid; font-weight: bold;\">\n    <div class=\"col-xs-7 column-break\">\n\n    </div>\n    <div class=\"col-xs-5 column-break\">\n        <div class=\"col-xs-6 column-break\">\n            <div class=\"row\"> {{_(\"Sub Totat\")}} </div>\n            <div class=\"row\"> {{_(\"Discount\")}} </div>\n            <div class=\"row\"> {{_(\"VAT\")}} </div>\n            <div class=\"row\"> {{_(\"Total\")}} </div>\n        </div>\n        <div class=\"col-xs-6 column-break text-right\">\n            <div class=\"row\"> {{\"%.2f\"|format(doc.total)}} </div>\n            <div class=\"row\"> {{\"%.2f\"|format(doc.discount_amount)}} </div>\n            <div class=\"row\"> {{\"%.2f\"|format(doc.total_taxes_and_charges)}}</div>\n            <div class=\"row\"> {{\"%.2f\"|format(doc.grand_total)}} </div>\n        </div>\n    </div>\n</div>\n\n\n<div class=\"row section-break\" style=\"color: blue; \">\n    <div class=\"col-xs-12 column-break\">\n        {%- if doc.terms -%}\n        <div class=\"row col-xs-12\"><b>{{_(\"Terms & Conditions\")}}:</b></div>\n        <div class=\"row col-xs-12\"> {{doc.terms}} </div>\n        {%- endif -%}\n        {%- if doc.payment_terms_template -%}\n        <div class=\"row col-xs-12\"><b>{{_(\"Payment Term\")}}:</b></div>\n        <div class=\"row col-xs-12\">\n        {%- for term in doc.payment_schedule-%}\n            <span>{{term.invoice_portion}}% - {{term.payment_term}}</span></br>\n        {%-endfor-%}\n        </div>\n        {%- endif -%}\n    \n        <div class=\"row col-xs-12\" style=\"padding-top: 20px;\"><b>{{_(\"Send all correspondence to\")}}:</b></div>\n    </div>\n</div>\n<div class=\"row section-break\" style=\"color: blue;\">\n    <div class=\"col-xs-12 column-break\">\n        <div class=\"col-xs-6 column-break\" style=\"padding-right:0px;padding-left:0px;padding-bottom: 20px;\">\n            {{doc.billing_address_display}}\n        </div>\n        <div class=\"col-xs-3 column-break text-center\">\n            {{_(\"Authorized By\")}}\n        </div>\n        <div class=\"col-xs-3 column-break text-center;\">\n            {{_(\"Date\")}}\n        </div>\n    </div>\n</div>\n\n<div class=\"row section-break\" style=\"border-top: 1px solid;padding-top:10px;\">\n    <div class=\"col-xs-6 column-break\">\n        Prepared By: {{ frappe.session.user }}\n    </div>\n    <div class=\"col-xs-6 column-break text-right\">\n        {{ frappe.utils.now() }}\n    </div>\n</div>\n\n",
